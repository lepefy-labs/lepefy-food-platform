# Copia in apps/storefront/.env.local e compila. Solo valori di TEST/LOCALI: mai chiavi live.
# Per i valori locali di Supabase: `supabase status -o env` (da ~/supabase-local).
NEXT_PUBLIC_TENANT_SLUG=chloefood
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opzionali (solo chiavi di test, mai live):
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# PACKLINK_API_KEY=
# ADMIN_EMAILS=
# Altre variabili: sezione "Key Environment Variables" di CLAUDE.md.
