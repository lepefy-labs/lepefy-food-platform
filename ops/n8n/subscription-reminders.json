    {
      "id": "c4e7b9a2-6d18-4e3f-9b05-7a2c8e4d1f03",
      "name": "Send subscription reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "https://shop.chloefood.com/api/internal/subscription-reminders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 55000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 30000
    },
    {
      "id": "e9b1f5c3-2a47-4d8e-b6c0-3f8d1a5e7b04",
      "name": "Check reminders outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        770,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const outcomes = $input.first()?.json?.outcomes;\nif (!outcomes || Number(outcomes.failed ?? 0) > 0) {\n  // Throw without echoing upstream responses, HTTP headers, or credentials.\n  throw new Error(\"subscription_reminders_failed\");\n}\nreturn [{ json: { ok: true, sent: Number(outcomes.sent ?? 0), notDue: Number(outcomes.not_due ?? 0), noRecipients: Number(outcomes.no_recipients ?? 0) } }];"
      }
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
