      "name": "Check schedule outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        770,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result = $input.first()?.json ?? {};\nconst counts = ['started', 'ended', 'expired', 'noveltiesEnded'].map((key) => Number(result[key] ?? 0));\nif (result.ok !== true || counts.some((value) => !Number.isSafeInteger(value) || value < 0)) {\n  // Throw without echoing upstream responses, HTTP headers, or credentials.\n  throw new Error(\"catalog_schedule_tick_failed\");\n}\nconst [started, ended, expired, noveltiesEnded] = counts;\nreturn [{ json: { ok: true, started, ended, expired, noveltiesEnded } }];"
      }
    }
