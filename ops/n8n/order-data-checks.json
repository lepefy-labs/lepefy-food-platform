    {
      "id": "1b2c3d4e-5f6a-4b7c-8d9e-0f1a2b3c4d73",
      "name": "Run order data checks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "https://shop.chloefood.com/api/internal/order-data-checks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 55000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 15000
    },
    {
      "id": "3d4e5f6a-7b8c-4d9e-8f0a-1b2c3d4e5f74",
      "name": "Check data checks outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        770,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result = $input.first()?.json ?? {};\nconst keys = ['scanned', 'withIssues', 'notified', 'alreadyNotified', 'noRecipient', 'failed'];\nconst counts = keys.map((key) => Number(result[key] ?? 0));\nif (result.ok !== true || counts.some((value) => !Number.isSafeInteger(value) || value < 0)) {\n  // Throw without echoing upstream responses, HTTP headers, or credentials.\n  throw new Error(\"order_data_checks_tick_failed\");\n}\nreturn [{ json: Object.fromEntries([['ok', true], ...keys.map((key, index) => [key, counts[index]])]) }];"
      }
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
        [
          {
