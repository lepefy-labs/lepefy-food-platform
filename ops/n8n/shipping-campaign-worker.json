      "maxTries": 2,
      "waitBetweenTries": 15000
    },
    {
      "id": "c3bf2681-f5ee-441f-962c-87f33eff51ad",
      "name": "Check batch outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        770,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result = $input.first()?.json ?? {};\nconst processed = Number(result.processed ?? 0);\nconst failed = Number(result.failed ?? 0);\nif (result.ok !== true || !Number.isFinite(processed) || !Number.isFinite(failed) || failed > 0) {\n  // Throw without echoing upstream responses, HTTP headers, or credentials.\n  throw new Error('shipping_campaign_batch_failed');\n}\nreturn [{ json: { ok: true, processed, succeeded: Number(result.succeeded ?? 0), skipped: Number(result.skipped ?? 0), failed: 0 } }];"
      }
    }
  ],
