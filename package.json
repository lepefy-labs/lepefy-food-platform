{
  "name": "lepefy-food",
  "private": true,
  "version": "0.0.1",
  "engines": { "node": ">=18" },
  "packageManager": "pnpm@8.15.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "pnpm --filter @lepefy/storefront dev",
    "build": "pnpm --filter @lepefy/storefront build",
    "lint": "pnpm --filter @lepefy/storefront lint",
    "typecheck": "pnpm --filter @lepefy/storefront typecheck",
    "catalog:whatsapp:test": "pnpm --filter @lepefy/storefront catalog:whatsapp:test",
    "engineering:index": "pnpm --filter @lepefy/storefront engineering:index",
    "engineering:sync": "pnpm --filter @lepefy/storefront engineering:sync",
    "engineering:docs-check": "pnpm --filter @lepefy/storefront engineering:docs-check",
    "engineering:benchmark": "pnpm --filter @lepefy/storefront engineering:benchmark",
    "catalog:whatsapp:review": "pnpm --filter @lepefy/storefront catalog:whatsapp:review"
  }
}
