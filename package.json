{
  "name": "lepefy-food",
  "private": true,
  "version": "0.0.1",
  "engines": { "node": ">=18" },
  "packageManager": "pnpm@8.15.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
